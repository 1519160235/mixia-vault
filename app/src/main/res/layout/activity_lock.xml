<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="26dp"
        android:paddingTop="56dp"
        android:paddingRight="26dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_shield"
            android:tint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.22"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_tagline"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/createGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/LabelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主密码" />

            <EditText
                android:id="@+id/master1"
                style="@style/FieldEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="至少 10 个字符"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                style="@style/LabelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="确认主密码" />

            <EditText
                android:id="@+id/master2"
                style="@style/FieldEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="再输入一次"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                style="@style/LabelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="密码提示（可选）" />

            <EditText
                android:id="@+id/hintInput"
                style="@style/FieldEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="只在连续输错后显示"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:text="主密码只存在于你的记忆里：应用不会上传、也不会保存明文。忘记主密码 = 数据永久无法解密，请务必记牢。"
                android:textColor="@color/danger"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCreate"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="创建保险库" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/unlockGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/masterInput"
                style="@style/FieldEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="输入主密码"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnUnlock"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="解锁" />

            <Button
                android:id="@+id/btnFingerprint"
                style="@style/GhostButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="指纹解锁"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="22dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="AES-256-GCM 加密 · PBKDF2 密钥派生\n所有数据仅保存在本机 · 应用无网络权限"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
