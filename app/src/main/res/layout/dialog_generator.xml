<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:paddingLeft="20dp"
    android:paddingTop="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="密码生成器"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/genPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_bg"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:textColor="@color/accent"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/genStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/genLengthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="长度 20"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/genLength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:max="48"
                android:progress="12" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbUpper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:checked="true"
            android:text="大写字母 A-Z"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/cbLower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:checked="true"
            android:text="小写字母 a-z"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/cbDigits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:checked="true"
            android:text="数字 0-9"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/cbSymbols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:checked="true"
            android:text="符号 !@#$%^&amp;*"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/cbAmbiguous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:checked="true"
            android:text="排除易混淆字符 1lI0O"
            android:textColor="@color/text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRegen"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="换一个" />

            <Button
                android:id="@+id/btnCopyGen"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="复制" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
