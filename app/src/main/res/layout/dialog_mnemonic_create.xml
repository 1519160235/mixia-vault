<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:paddingLeft="20dp"
    android:paddingTop="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="14dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加助记词"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            style="@style/LabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="名称" />

        <EditText
            android:id="@+id/wTitleInput"
            style="@style/FieldEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：主钱包、交易所备用"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            style="@style/LabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="生成新助记词（BIP39）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGen12"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="生成 12 词" />

            <Button
                android:id="@+id/btnGen24"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="生成 24 词" />
        </LinearLayout>

        <TextView
            style="@style/LabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="或导入已有助记词" />

        <EditText
            android:id="@+id/importInput"
            style="@style/FieldEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="粘贴 12/15/18/21/24 个英文单词"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minHeight="90dp"
            android:singleLine="false" />

        <TextView
            android:id="@+id/importError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnImport"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="校验并保存" />
    </LinearLayout>
</ScrollView>
