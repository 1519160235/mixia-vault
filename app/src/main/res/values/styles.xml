<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorControlNormal">@color/text_dim</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="LabelText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="FieldEdit">
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#062B25</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="GhostButton">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="DangerButton">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
