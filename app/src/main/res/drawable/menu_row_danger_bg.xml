<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#3A1D26" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#8E2F3D" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#241319" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#5C2733" />
        </shape>
    </item>
</selector>
